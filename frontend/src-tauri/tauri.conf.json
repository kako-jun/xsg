{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "XSG",
  "version": "1.0.0",
  "identifier": "com.kako-jun.xsg",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "XSG - Signal Generator",
        "width": 1920,
        "height": 1080,
        "resizable": false,
        "fullscreen": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "kako-jun",
    "category": "DeveloperTool",
    "shortDescription": "Professional test pattern generator",
    "longDescription": "XSG is a professional signal generator application that provides various test patterns for display calibration and video testing."
  }
}
